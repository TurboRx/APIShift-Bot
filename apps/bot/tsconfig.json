{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["@cloudflare/workers-types", "node"],
    "paths": {
      "@apishift/core": ["../../packages/core/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
